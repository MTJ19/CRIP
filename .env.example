# Supabase & Database Configuration

# Supabase Project URL & Anon Key (Frontend)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Supabase Service Role Key (Optional, for backend admin operations)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Postgres Connection String (Direct or Supabase Pooler)
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
# Leave unset or empty to use local persistent storage fallback (sqlite:///./burnin_storage.db)
DATABASE_URL=
